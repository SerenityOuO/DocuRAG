# App
APP_ENV=local
APP_NAME=DocuRAG AgentOps
APP_VERSION=0.35.0
DOCURAG_VERSION=0.35.0

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=docurag
POSTGRES_USER=docurag
POSTGRES_PASSWORD=docurag
DOCURAG_REPOSITORY_PROVIDER=local_json
DOCURAG_DATABASE_URL=postgresql://docurag:docurag@localhost:5432/docurag

# Redis / Qdrant / NATS
# Phase 33 Redis slice is opt-in. Leave DOCURAG_REDIS_URL empty to keep the fallback-only demo path.
REDIS_URL=redis://localhost:6379/0
DOCURAG_REDIS_URL=
DOCURAG_REDIS_TIMEOUT_SECONDS=1
DOCURAG_REDIS_SESSION_TTL_SECONDS=3600
DOCURAG_REDIS_QUERY_CACHE_TTL_SECONDS=60
DOCURAG_REDIS_RATE_LIMIT_PER_MINUTE=60
DOCURAG_REDIS_RATE_LIMIT_WINDOW_SECONDS=60
QDRANT_URL=http://localhost:6333
NATS_URL=nats://localhost:4222
# Phase 33 NATS worker skeleton is opt-in. Use memory:// for local smoke or nats://nats:4222 in Compose with the nats profile.
DOCURAG_NATS_URL=
DOCURAG_NATS_TIMEOUT_SECONDS=1
DOCURAG_NATS_TASK_MAX_ATTEMPTS=3

# Auth
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Phase 32 formal Auth/RBAC schema migration uses DOCURAG_DATABASE_URL.
# DOCURAG_AUTH_MODE=demo remains an explicit local validation fallback, not production RBAC.
DOCURAG_AUTH_MODE=disabled
DOCURAG_AUTH_DEMO_SECRET=docurag-demo-auth-secret
DOCURAG_AUTH_FORMAL_SECRET=docurag-formal-auth-local-secret

# Phase 34 PDF rendering keeps scanned PDF page images bounded for local OCR handoff.
DOCURAG_PDF_RENDER_DPI=150
DOCURAG_PDF_RENDER_MAX_SIDE=1800

# Phase 10 LLM / VLM provider decision. Set DOCURAG_LLM_PROVIDER= to disable local LLM generation.
DOCURAG_LLM_PROVIDER=ollama
DOCURAG_LLM_BASE_URL=http://127.0.0.1:11434
DOCURAG_LLM_MODEL=qwen3.5:4b
DOCURAG_LLM_THINK=false
DOCURAG_LLM_NUM_PREDICT=512
DOCURAG_VLM_PROVIDER=ollama
DOCURAG_VLM_MODEL=qwen3.5:4b

# Phase 27 aggressive demo defaults enable vector-first retrieval with fallback.
DOCURAG_EMBEDDING_PROVIDER=ollama
DOCURAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
DOCURAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
DOCURAG_EMBEDDING_TIMEOUT_SECONDS=30
DOCURAG_QDRANT_URL=http://127.0.0.1:6333
DOCURAG_QDRANT_COLLECTION=docurag_chunks_v1
DOCURAG_QDRANT_VECTOR_SIZE=1024
DOCURAG_QDRANT_TIMEOUT_SECONDS=10
DOCURAG_RAG_RETRIEVAL_PROVIDER=hybrid_rerank

# FastEmbed is lazy-loaded; unavailable runtime falls back with trace metadata.
DOCURAG_RERANK_PROVIDER=fastembed
DOCURAG_RERANK_MODEL=BAAI/bge-reranker-base
DOCURAG_RERANK_TOP_K=5
DOCURAG_RERANK_TIMEOUT_SECONDS=30

# Reserved fallback endpoint; not used by the v0.27.0 default path.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_API_KEY=
